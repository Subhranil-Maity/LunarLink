<?xml version="1.0" encoding="utf-8"?>
<!--
    Saved servers are encrypted with an Android Keystore key that is never backed up, so a
    restored copy could not be decrypted. Keep them (and their passwords) out of backups.
    Settings are fine to back up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/servers.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/servers.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
